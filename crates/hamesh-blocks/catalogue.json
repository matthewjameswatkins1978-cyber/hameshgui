{"blocks": [{"actions": [], "children": "any blocks", "description": "Horizontal arrangement. wrap=true turns it into a responsive row that breaks equal tiles onto the next line.", "example": "row(s, \"tiles\", LayoutOpts::tiles(), |r| { metric(r, ...); })", "kind": "layout", "name": "Row", "props": [{"default": "12", "name": "pad", "type": "f32"}, {"default": "8", "name": "gap", "type": "f32"}, {"default": false, "name": "wrap", "type": "bool"}, {"default": "auto", "name": "basis", "type": "f32"}]}, {"actions": [], "children": "any blocks", "description": "Vertical arrangement. The default container.", "example": "col(s, \"main\", LayoutOpts::default(), |c| { title(c, ...); })", "kind": "layout", "name": "Column", "props": [{"default": "12", "name": "pad", "type": "f32"}, {"default": "8", "name": "gap", "type": "f32"}]}, {"actions": [], "children": "none", "description": "Flexible empty space. Ghost: holds layout room, paints nothing, never intercepts the Hand.", "example": "spacer(r, \"hsp\");", "kind": "layout", "name": "Spacer", "props": []}, {"actions": [], "children": "none", "description": "Hairline separator (1px, border token).", "example": "divider(c, \"sep\");", "kind": "layout", "name": "Divider", "props": []}, {"actions": [], "children": "none", "description": "Prominent screen or page title (28px, text token). Sizes to content.", "example": "title(c, \"t\", \"Agent X\");", "kind": "typography", "name": "Title", "props": [{"name": "text", "required": true, "type": "string"}]}, {"actions": [], "children": "none", "description": "Section heading (18px, text token).", "example": "heading(c, \"h\", \"Development progress\");", "kind": "typography", "name": "Heading", "props": [{"name": "text", "required": true, "type": "string"}]}, {"actions": [], "children": "none", "description": "Standard body copy (15px, text token).", "example": "body(c, \"b\", \"...\" );", "kind": "typography", "name": "Body", "props": [{"name": "text", "required": true, "type": "string"}]}, {"actions": [], "children": "none", "description": "Small descriptive label (12px, muted token).", "example": "caption(c, \"v\", \"75%\");", "kind": "typography", "name": "Caption", "props": [{"name": "text", "required": true, "type": "string"}]}, {"actions": [], "children": "none", "description": "Muted secondary line (15px, dim token) for subtitles and hints.", "example": "subtle(c, \"s\", \"Autonomous operations overview\");", "kind": "typography", "name": "Subtle", "props": [{"name": "text", "required": true, "type": "string"}]}, {"actions": [], "children": "any blocks", "description": "Rounded, bordered container with generous padding. The outer surface of compositions.", "example": "card(s, \"dash\", CardOpts::default(), |t| { ... })", "kind": "surface", "name": "Card", "props": [{"default": "16", "name": "pad", "type": "f32"}, {"default": "14", "name": "radius", "type": "f32"}, {"default": "surface", "name": "surface", "type": "token"}, {"default": "1", "name": "border_w", "type": "f32"}]}, {"actions": [], "children": "none", "description": "Status pill: label colored by variant, centered on the cross axis. Variants: success, warning, error, info, neutral.", "example": "badge(r, \"st\", \"Connected\", Variant::Success);", "kind": "indicator", "name": "Badge", "props": [{"name": "text", "required": true, "type": "string"}, {"name": "variant", "required": true, "type": "success|warning|error|info|neutral"}]}, {"actions": [], "children": "none", "description": "Restrained line icon (Lucide path, stroked in token color). Registry: users, list-checks, triangle-alert, activity. Unknown names draw nothing.", "example": "icon(t, \"ic\", \"users\", \"text_dim\", \"raised\", 20.0);", "kind": "indicator", "name": "Icon", "props": [{"name": "icon", "required": true, "type": "users|list-checks|triangle-alert|activity"}, {"default": "text_dim", "name": "token", "type": "token"}, {"default": "raised", "name": "surface", "type": "token"}]}, {"actions": [], "children": "none (owns icon+value+label nodes)", "description": "Statistic tile: icon, prominent value, muted label. basis 0 + grow 1 shares rows equally. Value/props stay Eye-readable.", "example": "metric(r, \"m\", MetricOpts::new(\"Agents\", \"4\", \"users\"));", "kind": "composite", "name": "Metric", "props": [{"name": "label", "required": true, "type": "string"}, {"name": "value", "required": true, "type": "string"}, {"name": "icon_name", "required": true, "type": "icon"}]}, {"actions": [], "children": "none", "description": "Thin progress bar: track surface + accent fill from a real number. Exposes value/min/max/fill to the Eye.", "example": "progress(c, \"bar\", ProgressOpts::new(75.0));", "kind": "indicator", "name": "Progress", "props": [{"name": "value", "required": true, "type": "f32"}, {"default": 0, "name": "min", "type": "f32"}, {"default": 100, "name": "max", "type": "f32"}, {"default": "accent", "name": "fill", "type": "token"}]}, {"actions": [{"args": [], "effect": "host applies the named command through the canonical automation path (hit-tested, traced)", "name": "named action (e.g. inspect_design)"}], "children": "none", "description": "Labeled button with a named action. The host owns behavior; the block declares intent. Variants: primary, outline, ghost.", "example": "button(r, \"go\", \"Inspect design\", ButtonOpts::new(ButtonVariant::Outline, \"inspect_design\"));", "kind": "control", "name": "Button", "props": [{"name": "label", "required": true, "type": "string"}, {"name": "variant", "required": true, "type": "primary|outline|ghost"}, {"name": "action", "required": true, "type": "command"}]}]}
